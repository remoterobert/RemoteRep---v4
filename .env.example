# Copy this file to .env.local and fill in real values for local development.
# .env.local is gitignored; .env.example is committed as documentation.

# --- Supabase ---
# Get these from your Supabase project dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# --- Site URL (canonical origin for email links etc.) ---
# Local dev: http://localhost:3000
# Production: https://remoterep-v4-production.up.railway.app
# DO NOT rely on forwarded headers alone on Railway — its internal host is
# localhost:8080 which would end up in email verification links if used.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Resend (transactional email) ---
RESEND_API_KEY=re_...

# --- Fractional CRO intake (/fractional-cro) — see docs/REP-LANDING-PAGES.md ---
# CRO_BOOKING_URL=https://calendly.com/...   # calendar shown after someone applies
# CRO_LEADS_NOTIFY_EMAIL=you@remoterep.com    # email alert for each application
# CRO_LEADS_WEBHOOK_URL=https://...           # optional CRM webhook (e.g. GoHighLevel)

# --- GoHighLevel lead sync — see docs/GHL-INTEGRATION.md ---
# GHL_TALENT_API_TOKEN=pit-...                # talent sub-account Private Integration key
# GHL_TALENT_LOCATION_ID=...
# GHL_CLIENT_API_TOKEN=pit-...                # client sub-account Private Integration key
# GHL_CLIENT_LOCATION_ID=...
# GHL_REP_PIPELINE_ID= / GHL_REP_STAGE_ID=    # optional; IDs listed on /admin/env-check
# GHL_CRO_PIPELINE_ID= / GHL_CRO_STAGE_ID=
# GHL_CLIENT_PIPELINE_ID= / GHL_CLIENT_STAGE_ID=

# --- Added in future phases ---
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...     # server-only; never expose to browser
# STRIPE_SECRET_KEY=sk_live_... or sk_test_...    # payments (Phase 3)
# STRIPE_WEBHOOK_SECRET=whsec_...
# CLOUDFLARE_R2_ACCOUNT_ID=...                # file uploads (Phase 2)
# CLOUDFLARE_R2_ACCESS_KEY_ID=...
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=...
# CLOUDFLARE_R2_BUCKET=...
