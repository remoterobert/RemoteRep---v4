# Copy this file to .env.local and fill in real values for local development.
# .env.local is gitignored; .env.example is committed as documentation.

# --- Supabase ---
# Get these from your Supabase project dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# --- Site URL (canonical origin for email links etc.) ---
# Local dev: http://localhost:3000
# Production: https://remoterep-v4-production.up.railway.app
# DO NOT rely on forwarded headers alone on Railway — its internal host is
# localhost:8080 which would end up in email verification links if used.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Resend (transactional email) ---
RESEND_API_KEY=re_...

# --- GoHighLevel (CRM) ---
# v4 uses GHL's v2 API. The v1 API that v3 used reached end-of-support on
# 2025-12-31 — the old GHL_CLIENT_KEY / GHL_TALENT_KEY values will NOT work
# here. See docs/GOHIGHLEVEL.md for how to get these.
#
# Private Integration Token: GHL -> Settings -> Private Integrations.
# Needs contacts (read/write) and opportunities (read/write) scopes.
# GHL_PRIVATE_TOKEN=pit-...
# GHL_LOCATION_ID=...                         # the sub-account id
#
# If the talent and client pipelines live in DIFFERENT sub-accounts, set
# these instead of (or as well as) the shared pair above. Anything unset
# falls back to the shared value.
# GHL_TALENT_TOKEN=pit-...
# GHL_TALENT_LOCATION_ID=...
# GHL_CLIENT_TOKEN=pit-...
# GHL_CLIENT_LOCATION_ID=...
#
# Pipeline + stage ids. Optional — these default to the ids v3 used, so
# only set them if the pipelines were rebuilt in GHL.
# GHL_TALENT_PIPELINE_ID=Q0vVyvzi1qKRrXvYGi2n
# GHL_TALENT_STAGE_ID=6c9c0dbc-2316-47bf-8919-19a61744dd5d
# GHL_CLIENT_PIPELINE_ID=WxrJIMYTpwIngsR7gO05
# GHL_CLIENT_STAGE_ID=7c57756d-1eb6-408c-9208-5268189098e8
#
# Dry run logs what WOULD be sent instead of calling GHL. Defaults to on
# everywhere except production, so a dev machine can't write to the live
# CRM by accident. Set to "false" in production to actually send.
# GHL_DRY_RUN=true
#
# Separate from the above: the support form POSTs tickets to a GHL inbound
# webhook. Unrelated to the CRM pipelines; safe to leave unset.
# GHL_SUPPORT_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/...
# SLACK_SUPPORT_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- Added in future phases ---
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...     # server-only; never expose to browser
# STRIPE_SECRET_KEY=sk_live_... or sk_test_...    # payments (Phase 3)
# STRIPE_WEBHOOK_SECRET=whsec_...
# CLOUDFLARE_R2_ACCOUNT_ID=...                # file uploads (Phase 2)
# CLOUDFLARE_R2_ACCESS_KEY_ID=...
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=...
# CLOUDFLARE_R2_BUCKET=...
