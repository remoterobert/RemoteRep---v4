# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (any depth — covers v3-archive/*/node_modules too)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js (any depth)
.next/
/out/

# production builds (any depth — covers v3-archive/server/dist too)
/build
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — all .env* are gitignored EXCEPT .env.example (the template)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local-only safety fallback (pre-v4 git history snapshot)
.git.old/
.v3-data/
